    },
    {
      "parameters": {
        "jsCode": "\nconst conversationId = $('Webhook').item.json.body.conversation.id;\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    content: '⚠️ Aún no tienes una cuenta registrada en **IAGRO**.\\n\\n👉 Por favor, ingresa al siguiente enlace y completa tu registro:\\n\\nhttps://iagro360.xyz/register.html\\n\\nUna vez registrado, podrás acceder a los servicios de *IAGRO*. 🌱'\n  }\n}];\n"
