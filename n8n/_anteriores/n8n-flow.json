        "jsCode": "\nconst conversationId = $('Webhook').item.json.body.conversation.id;\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    content: '⚠️ No pudimos obtener el pronóstico en este momento. Por favor, intenta nuevamente en unos minutos. 🙏'\n  }\n}];\n"
      },
