    {
      "parameters": {
        "url": "={{ $('Configuración Global').item.json.weather_api_url }}/forecast/hourly?lat={{ $json.usuario.latitude }}&lon={{ $json.usuario.longitude }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        304
      ],
      "id": "4ba7e90d-80f7-4a2b-8117-272563902f09",
      "name": "Consultar API Clima",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $json.data || [];\nconst usuario = $('Buscar Usuario por Teléfono').first().json;\nconst conversationId = $('Webhook').item.json.body.conversation.id;\n\n// ===== Ajustes =====\nconst MM_MINIMO = 1;        // menos de esto en el día NO se considera lluvia (para \"Próxima lluvia\")\nconst VIENTO_FUMIGAR = 20;  // km/h: desde aquí no se recomienda fumigar\nconst DIAS_LISTA = 8;       // cuántos días van en \"Próximos días\"\n\n// ===== Funciones auxiliares =====\nconst num = (v) => parseFloat(v);\n\nconst avgWind = (horarios) => {\n  const vals = horarios.map(h => num(h.vsd)).filter(v => !isNaN(v));\n  return vals.length ? Math.round(vals.reduce((a, b) => a + b, 0) / vals.length) : 0;\n};\n\nconst avgWindDir = (horarios) => {\n  const dirs = horarios.map(h => h.vdId).filter(Boolean);\n  if (!dirs.length) return '';\n  const freq = {};\n  dirs.forEach(d => freq[d] = (freq[d] || 0) + 1);\n  return Object.entries(freq).sort((a, b) => b[1] - a[1])[0][0];\n};\n\nconst temps = (horarios) => horarios.map(h => num(h.td)).filter(v => !isNaN(v));\nconst maxTemp = (horarios) => { const t = temps(horarios); return t.length ? Math.round(Math.max(...t)) : '-'; };\nconst minTemp = (horarios) => { const t = temps(horarios); return t.length ? Math.round(Math.min(...t)) : '-'; };\n\nconst totalMm = (horarios) => horarios.reduce((s, h) => s + (num(h.sr) || 0), 0);\n\n// Formato de mm: entero si es grande, 1 decimal si es poco\nconst fmtMm = (mm) => mm >= 1 ? String(Math.round(mm)) : (Math.round(mm * 10) / 10).toFixed(1);\n\nconst parseFecha = (fecha) => {\n  const [dia, mes, anio] = fecha.split('/');\n  return new Date(anio, mes - 1, dia, 12); // evita errores de zona horaria\n};\nconst nombreLargo = (f) => ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'][parseFecha(f).getDay()];\nconst nombreCorto = (f) => ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'][parseFecha(f).getDay()];\nconst ddmm = (f) => f.slice(0, 5); // \"06/10/2026\" -> \"06/10\"\n\n// ===== Procesar días (hoy + DIAS_LISTA días siguientes) =====\nconst dias = data.slice(0, 1 + DIAS_LISTA).map(dia => {\n  const horarios = dia.horarios || [];\n  const mm = totalMm(horarios);\n  const horasLluvia = horarios.filter(h => num(h.sr) > 0);\n  // Hora de inicio: primera hora con lluvia\n  const primera = horasLluvia[0];\n  // Probabilidad: la máxima de las horas con lluvia\n  const prob = horasLluvia.length ? Math.max(...horasLluvia.map(h => num(h.rp) || 0)) : 0;\n  return {\n    fecha: dia.fecha,\n    minT: minTemp(horarios),\n    maxT: maxTemp(horarios),\n    viento: avgWind(horarios),\n    dir: avgWindDir(horarios),\n    mm,\n    llueve: mm >= MM_MINIMO,\n    lluviaLigera: mm > 0 && mm < MM_MINIMO,\n    horaInicio: primera ? primera.h : null,\n    prob,\n  };\n});\n\n// ===== Armar mensaje =====\nlet mensaje = `🌦️ **${usuario.nombre_propiedad}**\\n`;\n\nif (dias.length) {\n  const hoy = dias[0];\n\n  // HOY\n  mensaje += `\\n📍 *Hoy ${nombreLargo(hoy.fecha)} ${ddmm(hoy.fecha)}*\\n`;\n  mensaje += `🌡️ ${hoy.minT}° / ${hoy.maxT}°C  ·  💨 ${hoy.viento} km/h ${hoy.dir}\\n`;\n\n  // PRÓXIMA LLUVIA (depende del umbral MM_MINIMO)\n  const proxima = dias.find(d => d.llueve);\n  if (proxima) {\n    const cuando = proxima === hoy\n      ? 'hoy'\n      : `${nombreLargo(proxima.fecha)} ${ddmm(proxima.fecha)}`;\n    mensaje += `\\n🌧️ *Próxima lluvia:* ${cuando} desde las ${proxima.horaInicio}\\n`;\n    mensaje += `Se esperan unos ${Math.round(proxima.mm)} mm (probabilidad ${proxima.prob}%)\\n`;\n  } else {\n    mensaje += `\\n☀️ *Sin lluvias importantes en los próximos días*\\n`;\n  }\n\n  // PRÓXIMOS DÍAS (una línea por día)\n  mensaje += `\\n📅 *Próximos días*\\n`;\n  for (const d of dias.slice(1, 1 + DIAS_LISTA)) {\n    let icono, extra;\n    if (d.llueve) {\n      icono = '🌧️';\n      extra = `💧 ${fmtMm(d.mm)} mm`;\n    } else if (d.lluviaLigera) {\n      icono = '🌦️';\n      extra = `💧 ${fmtMm(d.mm)} mm`;\n    } else {\n      icono = '☀️';\n      extra = `💨 ${d.viento}`;\n    }\n    mensaje += `${nombreCorto(d.fecha)} ${ddmm(d.fecha)} ${icono} ${d.minT}°–${d.maxT}° ${extra}\\n`;\n  }\n\n  // RECOMENDACIÓN\n  const proximos3 = dias.slice(0, 3);\n  const ventosos = proximos3.filter(d => d.viento >= VIENTO_FUMIGAR).length;\n  const calorExtremo = proximos3.some(d => d.maxT !== '-' && d.maxT > 35);\n  const frio = proximos3.some(d => d.minT !== '-' && d.minT < 16);\n\n  const avisos = [];\n  if (proxima && proxima !== hoy) {\n    const diasSecos = dias.indexOf(proxima);\n    if (diasSecos >= 2) avisos.push(`${diasSecos} días secos antes de la lluvia`);\n  }\n  if (ventosos >= 2) avisos.push('⚠️ viento fuerte, no recomendable fumigar');\n  else if (!proxima || proxima !== hoy) avisos.push('✅ buen momento para aplicaciones en días de poco viento');\n  if (calorExtremo) avisos.push('🌡️ calor extremo');\n  if (frio) avisos.push('🥶 temperaturas frías');\n\n  if (avisos.length) mensaje += `\\n💡 *Resumen:* ${avisos.join(' · ')}\\n`;\n}\n\nmensaje += `\\n🌐 Radar en vivo: https://iagro360.xyz/radar/${usuario.id}\\n`;\nmensaje += `\\n📡 _IAGRO | Monitoreo Climático Inteligente_`;\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    content: mensaje,\n    content_type: 'input_select',\n    content_attributes: {\n      items: [\n        { title: '🌦️ Ver pronóstico', value: 'pronostico' },\n        { title: '🌧️ Ver radar', value: 'radar' }\n      ]\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
