{
  "name": "iagro-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel de administración del bot de alertas de clima IAGRO",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrar": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrar.mjs",
    "db:estado": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrar.mjs --estado",
    "db:demo": "node --env-file-if-exists=.env.local scripts/datos-demo.mjs",
    "admin:crear": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/crear-admin.mjs",
    "local:db": "docker compose -f docker-compose.dev.yml up -d",
    "local:db:parar": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "leaflet": "1.9.4",
    "lucide-react": "1.47.0",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "papaparse": "5.4.1",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "5.8.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "write-excel-file": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.12",
    "@types/node": "24.13.6",
    "@types/papaparse": "5.3.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.6"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
