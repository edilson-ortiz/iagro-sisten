          "name": "Header Auth account"
        }
      },
      "id": "de7f684a-d7b1-43f0-8992-e8cd3cb93619"
    },
    {
      "parameters": {
        "jsCode": "// Elige la conversación más reciente del contacto en el inbox de WhatsApp (abierta primero)\nconst p = $('Preparar').item.json;\nconst contacto = $('Contacto listo').item.json;\nconst convs = ($json.payload || []).filter((c) => Number(c.inbox_id) === p.inbox);\nconst prioridad = { open: 0, pending: 1, snoozed: 2, resolved: 3 };\nconvs.sort((a, b) => (prioridad[a.status] ?? 9) - (prioridad[b.status] ?? 9) || (b.last_activity_at || 0) - (a.last_activity_at || 0));\nreturn { json: { contact_id: contacto.contact_id, source_id: contacto.source_id, conversation_id: convs[0]?.id ?? null } };\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        200
      ],
      "name": "Elegir conversación",
      "id": "03a94fb1-3844-482f-bae6-d10bf15f3703"
    },
