      "parameters": {
        "jsCode": "\n// Postgres reemplaza $json con las columnas de la tabla (o vacio si no hay match).\n// Aqui lo recuperamos y lo adjuntamos como un solo objeto \"usuario\", conservando\n// todos los datos del mensaje original (intent, telefono, codigo, etc.)\nconst usuario = $json && $json.id ? $json : {};\nconst original = $('Parsear Mensaje y Detectar Intención').first().json;\n\nreturn [{\n  json: {\n    ...original,\n    usuario\n  }\n}];\n"
