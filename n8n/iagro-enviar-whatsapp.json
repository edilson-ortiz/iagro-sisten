    {
      "parameters": {
        "jsCode": "// Respuesta de POST /contacts → mismo formato que \"Contacto buscado\"\nconst c = $json.payload?.contact || $json.payload || $json;\nreturn { json: { contact_id: c.id, contact_inboxes: c.contact_inboxes || [] } };\n",
