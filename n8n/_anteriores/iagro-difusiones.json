    {
      "parameters": {
        "jsCode": "// Arma un mensaje por destinatario. {nombre} en el texto se reemplaza por el nombre del usuario.\nconst cfg = $('Configuración').first().json.cfg;\nconst filas = $('Preparar difusión').all().map((i) => i.json).filter((r) => r.envio_id);\n\nreturn filas.map((r) => {\n  const nombre = String(r.nombre || '').trim().split(/\\s+/)[0] || 'agricultor';\n  const texto = String(r.mensaje || '').replaceAll('{nombre}', nombre);\n  const dentro24h = r.ultimo_mensaje_el && (Date.now() - new Date(r.ultimo_mensaje_el).getTime()) < 23.5 * 3600 * 1000;\n  return {\n    json: {\n      envio_id: r.envio_id,\n      usuario_id: r.usuario_id,\n      telefono: r.telefono,\n      nombre: r.nombre || '',\n      chatwoot_contact_id: r.chatwoot_contact_id || null,\n      contenido: texto,\n      usar_plantilla: !dentro24h,\n      plantilla: {\n        nombre: r.plantilla || cfg.plantilla_difusion,\n        idioma: r.plantilla_idioma || cfg.plantilla_idioma || 'es',\n        parametros: [texto],\n      },\n      pausa_seg: Math.max(0, Number(cfg.difusion_pausa_ms ?? 1200)) / 1000,\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        100
      ],
      "name": "Armar mensajes",
      "id": "ebbc243f-6dea-4316-b943-0299b993304c"
    },
