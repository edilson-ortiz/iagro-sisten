    {
      "parameters": {
        "jsCode": "// Valida el token del panel y el id de la difusión\nconst h = $('Webhook panel').first().json.headers || {};\nconst body = $('Webhook panel').first().json.body || {};\nconst token = h['x-iagro-token'] || '';\nconst esperado = $('Token').first().json.token || '';\nconst id = Number(body.difusion_id);\nconst ok = !!esperado && token === esperado && Number.isInteger(id) && id > 0;\nreturn [{ json: { ok, difusion_id: ok ? id : null, motivo: ok ? null : (!token || token !== esperado ? 'Token inválido' : 'difusion_id inválido') } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
