    {
      "parameters": {
        "jsCode": "\n// Chatwoot envia el texto en body.content\nconst textoOriginal = ($json.body?.content || '').trim();\nconst texto = textoOriginal.toLowerCase();\n\nconst telefonoRaw = $json.body?.conversation?.meta?.sender?.phone_number || '';\nconst telefono = telefonoRaw.replace('+', '');\n\nlet intent = 'desconocido';\nlet codigo = null;\n\n// =====================================================\n// DETECTAR REGISTRO IAGRO\n// Formato esperado:\n// [IAGRO]:[BZuABk2]\n// =====================================================\nconst registroMatch = textoOriginal.match(/^\\s*\\[IAGRO\\]\\s*:\\s*\\[([A-Za-z0-9_-]+)\\]/i);\n\nif (registroMatch) {\n  intent = 'registro';\n  codigo = registroMatch[1];\n}\n\n// =====================================================\n// INTENCIONES NORMALES\n// (agregar nuevas palabras clave aqui = escala sin tocar el resto del flujo)\n// =====================================================\nif (intent === 'desconocido') {\n  const intents = {\n    pronostico: ['pronostico', 'pronóstico', 'clima', 'lluvia', 'tiempo', '🌦️ ver pronóstico'],\n    radar: ['radar', '🌧️ ver radar'],\n    saludo: ['hola', 'buenas', 'buenos dias', 'buen día'],\n    ayuda: ['ayuda', 'menu', 'menú', 'opciones'],\n    saludo_final: ['gracias', 'ok', 'perfecto', 'listo', 'entendido', 'hasta luego', 'adios', 'adiós', 'chau', 'nos vemos']\n  };\n\n  for (const [nombre, palabras] of Object.entries(intents)) {\n    if (palabras.some(p => texto.includes(p))) {\n      intent = nombre;\n      break;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    ...$json,\n    intent,\n    texto_original: textoOriginal,\n    texto,\n    codigo,\n    conversation_id: $json.body?.conversation?.id,\n    account_id: $json.body?.account?.id,\n    contact_name: $json.body?.conversation?.meta?.sender?.name || 'Cliente',\n    telefono\n  }\n}];\n"
      },
