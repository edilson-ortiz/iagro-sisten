    {
      "parameters": {
        "jsCode": "// Une el destinatario con el resultado del envío\nconst d = $('Armar mensajes').item.json;\nconst r = $json;\nreturn {\n  json: {\n    envio_id: String(d.envio_id),\n    conversation_id: r.conversation_id ? String(r.conversation_id) : '',\n    message_id: r.message_id ? String(r.message_id) : '',\n    contact_id: r.contact_id ? String(r.contact_id) : '',\n    error: r.ok ? '' : String(r.error || 'Error desconocido al enviar').slice(0, 500),\n    pausa_seg: d.pausa_seg,\n  },\n};\n",
        "mode": "runOnceForEachItem"
      },
