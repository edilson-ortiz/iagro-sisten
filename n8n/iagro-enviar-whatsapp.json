    {
      "parameters": {
        "jsCode": "// Resultado de /contacts/search: elige el contacto cuyo teléfono coincide exactamente\nconst p = $('Preparar').item.json;\nconst lista = $json.payload || [];\nconst c = lista.find((x) => String(x.phone_number || '').replace(/\\D/g, '') === p.tel);\nreturn { json: { contact_id: c ? c.id : null, contact_inboxes: c?.contact_inboxes || [] } };\n",
        "mode": "runOnceForEachItem"
