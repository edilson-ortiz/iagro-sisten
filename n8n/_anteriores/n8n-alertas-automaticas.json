    {
      "parameters": {
        "jsCode": "// Modo: \"Run Once for Each Item\"\n// Elige la conversación más reciente del contacto y arma el mensaje.\n// Si hay plantilla de WhatsApp configurada, la usa (obligatorio si el cliente\n// no escribió en las últimas 24 h; sin plantilla WhatsApp rechaza el mensaje).\nconst cfg = $('Configuración Alertas').first().json;\nconst alerta = $('Calcular Alertas').item.json;\n\nconst convs = ($json.payload || []).slice().sort((a, b) => (b.last_activity_at || 0) - (a.last_activity_at || 0));\nconst conv = convs[0];\nif (!conv) return { json: { conversation_id: '' } };\n\nconst payload = { content: alerta.content, message_type: 'outgoing', private: false };\nif (cfg.plantilla_whatsapp) {\n  payload.template_params = {\n    name: cfg.plantilla_whatsapp,\n    category: 'UTILITY',\n    language: cfg.plantilla_idioma || 'es',\n    processed_params: { '1': alerta.resumen_plantilla.slice(0, 900) }\n  };\n}\n\nreturn { json: { conversation_id: String(conv.id), chatwoot_payload: payload } };\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
