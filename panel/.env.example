# =========================================================
# Panel IAGRO — variables de entorno
# Copia este archivo como .env y completa los valores.
# =========================================================

# Conexión a PostgreSQL: la MISMA base "trd" que usa la credencial "Postgres account" de n8n.
# Dentro de Docker, el host es el nombre del contenedor de Postgres (ej: postgres).
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:5432/trd
DATABASE_URL=postgres://postgres:CAMBIAR@postgres:5432/trd

# (Se completan en las fases siguientes)
# SESSION_SECRET=        # cadena aleatoria de 32+ caracteres para firmar la sesión del panel
# N8N_WEBHOOK_DIFUSION=  # URL del webhook de n8n que envía difusiones
# N8N_WEBHOOK_TOKEN=     # token compartido entre el panel y n8n

# Token de acceso de Chatwoot (Perfil → Configuración del perfil → Token de acceso).
# Lo usa la página Consumo para contar los mensajes salientes por usuario (solo lectura).
CHATWOOT_API_TOKEN=
