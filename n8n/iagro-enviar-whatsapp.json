        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_id: $json.source_id, inbox_id: $('Preparar').item.json.inbox, contact_id: $json.contact_id, status: 'open' }) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3400,
        360
      ],
      "name": "Crear conversación",
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "3XgXgRqlWDyWhTB9",
          "name": "Header Auth account"
        }
      },
      "id": "8f34a006-63c1-4b24-96ff-1e1741596924"
    },
    {
      "parameters": {
        "jsCode": "// Arma el mensaje: plantilla aprobada (fuera de la ventana de 24 h) o texto libre\nconst e = $('Entrada').item.json;\nconst conv = $json.conversation_id ?? $json.id;\nconst contacto = $('Contacto listo').item.json;\n\nconst payload = { content: e.contenido, message_type: 'outgoing', private: false };\n// Texto con botones o lista (ej. \"⛈️ Solo lluvias fuertes\"): solo dentro de la ventana de 24 h\nif (!e.usar_plantilla && e.content_type) {\n  payload.content_type = e.content_type;\n  payload.content_attributes = e.content_attributes || {};\n}\nif (e.usar_plantilla) {\n  const params = {};\n  (e.plantilla.parametros || []).forEach((v, i) => {\n    // WhatsApp no acepta saltos de línea, tabulaciones ni más de 4 espacios seguidos en variables\n    params[String(i + 1)] = String(v ?? '').replace(/[\\r\\n\\t]+/g, ' ').replace(/ {4,}/g, '   ').trim().slice(0, 1000);\n  });\n  payload.template_params = {\n    name: e.plantilla.nombre,\n    category: 'UTILITY',\n    language: e.plantilla.idioma || 'es',\n    processed_params: params,\n  };\n}\nreturn { json: { conversation_id: conv, contact_id: contacto.contact_id, payload } };\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        200
      ],
      "name": "Armar mensaje",
      "id": "afcf5287-0f5b-4a63-8536-faca4ea60ec5"
    },
    {
      "parameters": {
        "url": "={{ $('Preparar').item.json.base }}/conversations/{{ $json.conversation_id }}/messages",
        "options": {
          "timeout": 20000
        },
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3800,
        200
      ],
      "name": "Enviar mensaje",
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "3XgXgRqlWDyWhTB9",
          "name": "Header Auth account"
        }
      },
      "id": "42d77dce-ac12-496f-933a-04e2e39904d7"
    },
    {
      "parameters": {
        "jsCode": "// Salida del sub-flujo cuando el mensaje se envió\nconst m = $('Armar mensaje').item.json;\nreturn {\n  json: {\n    ok: true,\n    usuario_id: $('Entrada').item.json.usuario_id,\n    contact_id: m.contact_id,\n    conversation_id: m.conversation_id,\n    message_id: $json.id,\n    error: null,\n  },\n};\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4000,
        200
      ],
      "name": "Resultado OK",
      "id": "8ecb71f6-fe59-4ffe-9dc4-bf74a4768045"
    },
    {
      "parameters": {
        "jsCode": "// Salida del sub-flujo cuando algo falló (validación o error de Chatwoot)\nconst e = $('Entrada').item.json;\nconst j = $json || {};\nlet detalle = j.error;\nif (detalle && typeof detalle === 'object') {\n  detalle = detalle.message || detalle.description || JSON.stringify(detalle);\n}\nif (!detalle) detalle = j.message || j.description || 'Error al comunicarse con Chatwoot';\nreturn {\n  json: {\n    ok: false,\n    usuario_id: e.usuario_id,\n    contact_id: null,\n    conversation_id: null,\n    message_id: null,\n    error: `[${$prevNode.name}] ${String(detalle)}`.slice(0, 500),\n  },\n};\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4000,
        520
      ],
      "name": "Resultado con error",
      "id": "891aed44-2cc5-4f60-9464-765ebb1ad87b"
    },
    {
      "parameters": {
        "content": "## 📤 IAGRO · Enviar WhatsApp (sub-flujo)\nLo usan **Alerta de lluvia** y **Difusiones**.\n\n1. Busca el contacto en Chatwoot por teléfono (o lo crea)\n2. Lo vincula al inbox de WhatsApp si hace falta\n3. Usa la conversación existente o abre una nueva\n4. Envía **plantilla** (fuera de 24 h) o **texto libre**\n\nDevuelve `{ ok, contact_id, conversation_id, message_id, error }`. Cualquier error termina en **Resultado con error** (nunca corta al flujo que lo llamó).\n\n⚙️ Datos de Chatwoot e inbox: panel → Configuración → WhatsApp.",
        "width": 760,
        "height": 300,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -160
      ],
      "name": "Nota",
      "id": "645cbea4-be38-47ea-8aa2-8a9cc06cd134"
    }
  ],
