      "parameters": {
        "jsCode": "// ¿El contacto ya está vinculado al inbox de WhatsApp? (source_id = número de WhatsApp)\nconst p = $('Preparar').item.json;\nconst ci = ($json.contact_inboxes || []).find((x) => Number(x.inbox?.id ?? x.inbox_id) === p.inbox);\nreturn { json: { contact_id: $json.contact_id, source_id: ci ? ci.source_id : null } };\n",
        "mode": "runOnceForEachItem"
