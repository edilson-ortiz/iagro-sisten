    {
      "parameters": {
        "jsCode": "// Entrada: { usuario_id, telefono, nombre, chatwoot_contact_id?, contenido, usar_plantilla, plantilla:{nombre, idioma, parametros[]} }\nconst e = $('Entrada').item.json;\nconst cfg = $json.cfg || {};\nconst base = `${String(cfg.chatwoot_url_publica || '').replace(/\\/+$/, '')}/api/v1/accounts/${cfg.chatwoot_account_id}`;\nconst inbox = Number(cfg.chatwoot_inbox_id || 0);\nconst tel = String(e.telefono || '').replace(/\\D/g, '');\n\nlet error = null;\nif (!cfg.chatwoot_url_publica || !cfg.chatwoot_account_id) error = 'Falta configurar la URL o la cuenta de Chatwoot (panel → Configuración → WhatsApp).';\nelse if (!inbox) error = 'Falta configurar el ID del inbox de WhatsApp (panel → Configuración → WhatsApp).';\nelse if (tel.length < 8) error = `Teléfono inválido: \"${e.telefono}\"`;\nelse if (e.usar_plantilla && !e.plantilla?.nombre) error = 'Falta el nombre de la plantilla de WhatsApp.';\n\nreturn { json: { base, inbox, tel, error } };\n",
        "mode": "runOnceForEachItem"
      },
