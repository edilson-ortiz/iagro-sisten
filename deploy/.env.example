# Copia este archivo como .env (en esta misma carpeta deploy/) y completa los valores.
# Nunca subas el .env a git ni lo compartas.

# Base "trd" del contenedor "postgres" (la misma que usa la credencial "Postgres account" de n8n).
# Usuario y contraseña: los de esa credencial de n8n.
DATABASE_URL=postgres://postgres:CAMBIAR@host.docker.internal:5432/trd

# Clave para firmar la sesión del panel (32+ caracteres). Generar con:  openssl rand -hex 32
SESSION_SECRET=CAMBIAR

# Token de acceso de Chatwoot (Perfil → Configuración del perfil → Token de acceso)
CHATWOOT_API_TOKEN=CAMBIAR

# Puerto del servidor donde escucha el panel (8080 = el que usa el túnel de Cloudflare).
# Para probar sin cortar el sitio viejo, usa 8081 y después cambia a 8080.
PUERTO=8080
